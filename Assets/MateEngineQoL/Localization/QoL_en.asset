  m_TableData:
  - m_Id: 1172287488
    m_Localized: PROVIDERS
    m_Metadata:
      m_Items: []
  - m_Id: 1222619136
    m_Localized: AI PROVIDERS
    m_Metadata:
      m_Items: []
  - m_Id: 1222619137
    m_Localized: CHAT PROVIDER
    m_Metadata:
      m_Items: []
  - m_Id: 1222619138
    m_Localized: Built-in
    m_Metadata:
      m_Items: []
  - m_Id: 1226813440
    m_Localized: SERVER URL
    m_Metadata:
      m_Items: []
  - m_Id: 1226813441
    m_Localized: MODEL
    m_Metadata:
      m_Items: []
  - m_Id: 1226813442
    m_Localized: e.g. llama3.2, or an OpenRouter id like meta-llama/llama-3.3-70b-instruct:free
    m_Metadata:
      m_Items: []
  - m_Id: 1226813443
    m_Localized: API KEY
    m_Metadata:
      m_Items: []
  - m_Id: 1226813444
    m_Localized: Paste key, then press Enter
    m_Metadata:
      m_Items: []
  - m_Id: 1226813445
    m_Localized: Key saved (encrypted for your Windows account)
    m_Metadata:
      m_Items: []
  - m_Id: 1226813446
    m_Localized: Using MEQOL_CHAT_API_KEY from the environment
    m_Metadata:
      m_Items: []
  - m_Id: 1226813447
    m_Localized: Not needed for this provider
    m_Metadata:
      m_Items: []
  - m_Id: 1226813448
    m_Localized: REMOVE KEY
    m_Metadata:
      m_Items: []
  - m_Id: 1226813449
    m_Localized: TEST CONNECTION
    m_Metadata:
      m_Items: []
  - m_Id: 1226813450
    m_Localized: Testing...
    m_Metadata:
      m_Items: []
  - m_Id: 1226813451
    m_Localized: 'Connected in {0} ms: "{1}"'
    m_Metadata:
      m_Items: []
  - m_Id: 1226813452
    m_Localized: 'Test failed: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1226813453
    m_Localized: Using the built-in local model. Pick a provider above to use a server
      instead.
    m_Metadata:
      m_Items: []
  - m_Id: 1226813454
    m_Localized: 'Not ready: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 1226813455
    m_Localized: 'Ready: replies come from {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 1226813456
    m_Localized: Your character prompt and chat history are sent to the server you
      choose. Local servers (Ollama, LM Studio) keep everything on this PC.
    m_Metadata:
      m_Items: []
  - m_Id: 881518948352
    m_Localized: Free. Mate Engine's own model runs on this PC.
    m_Metadata:
      m_Items: []
  - m_Id: 881565085696
    m_Localized: Free. Runs on this PC; install the app and pull a model first.
    m_Metadata:
      m_Items: []
  - m_Id: 881565085697
    m_Localized: Needs a key. Models ending in :free cost nothing; others are paid.
    m_Metadata:
      m_Items: []
  - m_Id: 881565085698
    m_Localized: Needs a key. Paid per use; billed by the provider.
    m_Metadata:
      m_Items: []
  - m_Id: 881565085699
    m_Localized: Any OpenAI-compatible server. https is required when a key is set.
    m_Metadata:
      m_Items: []
  - m_Id: 326419102019584
    m_Localized: CHARACTERS
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962624
    m_Localized: CHARACTER
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962625
    m_Localized: + New character
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962626
    m_Localized: New character
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962627
    m_Localized: NAME
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962628
    m_Localized: GREETING
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962629
    m_Localized: Optional first message in a new chat (not sent to the model)
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962630
    m_Localized: NEW CHAT
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962631
    m_Localized: 'Edit the character''s prompt in the AI section''s prompt box. In
      chat: /char <name> switches, /chars lists, /new starts a new chat.'
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962632
    m_Localized: 'No character called "{0}". Characters: {1}'
    m_Metadata:
      m_Items: []
  - m_Id: 326419143962633
    m_Localized: 'Talking to {0}. Characters: {1}. Switch with /char <name>.'
    m_Metadata:
      m_Items: []
  - m_Id: 589648218796032
    m_Localized: VOICE
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739072
    m_Localized: VOICE PROVIDER
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739073
    m_Localized: Off
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739074
    m_Localized: Replies are not spoken.
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739075
    m_Localized: 'Free. Runs on this PC: start Kokoro-FastAPI on port 8880 first.'
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739076
    m_Localized: Needs an OpenAI key. Paid per use (about $0.015 per minute of speech).
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739077
    m_Localized: Needs a Fish Audio key. Model s2.1-pro-free costs nothing; s1 and
      s2.1-pro need prepaid API credit. VOICE takes a voice model id from fish.audio.
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739078
    m_Localized: Any OpenAI-compatible /audio/speech server that can return WAV.
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739079
    m_Localized: VOICE
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739080
    m_Localized: e.g. af_heart (Kokoro), myvoice.wav (Chatterbox), alloy (OpenAI),
      or a Fish voice id
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739081
    m_Localized: e.g. kokoro, gpt-4o-mini-tts, or s2.1-pro-free for Fish
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739082
    m_Localized: Using MEQOL_TTS_API_KEY from the environment
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739083
    m_Localized: SPEED {0}x
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739084
    m_Localized: VOLUME {0}%
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739085
    m_Localized: TEST VOICE
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739086
    m_Localized: Speaking. First audio after {0} ms.
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739087
    m_Localized: Hi! This is how I sound. Do you like my voice?
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739088
    m_Localized: Voice is off.
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739089
    m_Localized: 'Ready: replies are spoken by {0}.'
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739090
    m_Localized: 'Last voice error: {0}'
    m_Metadata:
      m_Items: []
  - m_Id: 589648260739091
    m_Localized: Reply text is sent to the voice server; Kokoro keeps it on this
      PC. Text between *asterisks* is not spoken. Grab the avatar or send a new message
      to stop it talking.
    m_Metadata:
      m_Items: []
  - m_Id: 613410775478272
    m_Localized: 'Free. Runs on this PC and copies a voice from a short clip: start
      Chatterbox-TTS-Server on port 8004 first. VOICE is the clip''s file name in
      its reference_audio folder. Turbo plays *chuckles* and *sighs* as sounds.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
